# TAFA + endpoints locaux Kronos et Chronos — papier uniquement.
# Copiez ce fichier vers .env après avoir sauvegardé votre configuration existante.

TAFA_MODE=DEMO
ENABLE_LIVE=false
LIVE_CONFIRM=
TAFA_ENGINE=native
TAFA_PAPER_ONLY=true
TAFA_CYCLE_SLEEP=2.0
TAFA_DASHBOARD_HOST=127.0.0.1
# Le lanceur de stack démarre le dashboard séparément pour éviter un conflit
# de port avec le processus du bot.
TAFA_DASHBOARD_EXTERNAL=true
# Tick→candle est le chemin par défaut sur la websocket DEMO OKX ; activez
# uniquement après validation de l’instrument si vous voulez la souscription
# native de chandeliers.
TAFA_DEMO_CANDLE_SUBSCRIBE=false

# Le serveur reste local à cette machine et ne doit pas être exposé à Internet.
TAFA_MODEL_SERVER_HOST=127.0.0.1
TAFA_MODEL_SERVER_PORT=8787
TAFA_MODEL_DEVICE=cpu
TAFA_MODEL_SIGNAL_EDGE=0.002

# Active le consensus seulement si les deux modèles et la stratégie TAFA
# produisent le même signal. Les HOLD en cas de divergence sont intentionnels.
TAFA_FOUNDATION_MODELS_ENABLED=true
TAFA_FOUNDATION_MIN_CONFIDENCE=0.70
TAFA_FOUNDATION_CONTEXT=240
TAFA_FOUNDATION_TIMEOUT_S=8
TAFA_KRONOS_ENDPOINT=http://127.0.0.1:8787/kronos/predict
TAFA_CHRONOS_ENDPOINT=http://127.0.0.1:8787/chronos/predict

# Aucune clé OKX n’est requise ni acceptée pour ce profil.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
