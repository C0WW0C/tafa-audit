# TAFA V7 PRO — Environment (copy to .env — never commit secrets)

# DEMO (default) or LIVE
TAFA_MODE=DEMO

# Live trading triple-gate (ALL required for real orders)
ENABLE_LIVE=false
LIVE_CONFIRM=
# LIVE_CONFIRM must be exactly: I_UNDERSTAND_THE_RISK

# OKX API (required only for LIVE private endpoints)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional
TAFA_DEBUG=false
TAFA_CYCLE_SLEEP=2.0

# Engine: native | freqtrade | passivbot
TAFA_ENGINE=native

# Freqtrade (optional)
FREQTRADE_DIR=
FREQTRADE_CONFIG=
FREQTRADE_API=http://127.0.0.1:8080
FREQTRADE_API_USER=tafa
FREQTRADE_API_PASS=tafa

# PassivBot (optional)
PASSIVBOT_DIR=
PASSIVBOT_CONFIG=

# Hummingbot (optional)
HUMMINGBOT_DIR=
HUMMINGBOT_API=http://127.0.0.1:8000
HUMMINGBOT_API_USER=admin
HUMMINGBOT_API_PASS=admin
