# TAFA X Elite M7 — safe paper/demo OKX profile
# Copy this file to .env for an isolated paper/demo test.

TAFA_MODE=DEMO
ENABLE_LIVE=false
LIVE_CONFIRM=
TAFA_ENGINE=native
TAFA_PAPER_ONLY=true
TAFA_CYCLE_SLEEP=2.0
TAFA_DASHBOARD_HOST=127.0.0.1

# Keep all private OKX credentials empty for paper/demo testing.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional paper-only model consensus. Leave disabled until two dedicated,
# internal inference endpoints have been deployed and validated independently.
TAFA_FOUNDATION_MODELS_ENABLED=false
TAFA_FOUNDATION_MIN_CONFIDENCE=0.70
TAFA_FOUNDATION_CONTEXT=240
TAFA_FOUNDATION_TIMEOUT_S=4
TAFA_KRONOS_ENDPOINT=
TAFA_CHRONOS_ENDPOINT=

# Local endpoints started by scripts/start_local_model_server.sh.
# Use these values only after the health endpoint reports both models available.
# TAFA_KRONOS_ENDPOINT=http://127.0.0.1:8787/kronos/predict
# TAFA_CHRONOS_ENDPOINT=http://127.0.0.1:8787/chronos/predict
